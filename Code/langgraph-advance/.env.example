# Databricks Configuration
DATABRICKS_HOST=adb-1234567890.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/warehouse_id
DATABRICKS_TOKEN=dapi1234567890abcdef...

# Optional: Override default catalog/schema
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=digital_product

# LLM Configuration - OpenAI
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Optional: Future Bedrock Configuration (when supported)
# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
